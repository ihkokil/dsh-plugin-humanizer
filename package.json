{
  "name": "dsh-plugin-humanizer",
  "version": "1.0.0",
  "description": "Production-ready humanizer plugin for DeepSeek Harness (DSH) to rewrite AI-generated text into natural, human-like voice.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "humanizer",
    "ai-text-humanizer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihkokil/dsh-plugin-humanizer.git"
  },
  "bugs": {
    "url": "https://github.com/ihkokil/dsh-plugin-humanizer/issues"
  },
  "homepage": "https://github.com/ihkokil/dsh-plugin-humanizer#readme",
  "author": "Md. Iqbal Haider Khan <ihkokil@gmail.com>",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
